{
  "app": "npx ts-node --prefer-ts-exts bin/sandbox.ts",
  "watch": { "include": ["**"], "exclude": ["README.md", "cdk*.json", "**/*.d.ts", "**/*.js", "tsconfig.json", "package*.json", "node_modules", "test", "cdk.out"] },
  "context": {
    "dataClassification": "synthetic",
    "githubRepo": "alextthomas/Analyst-App-POC",
    "githubEnvironment": "sandbox",
    "expiresOn": "2026-12-03",
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/core:target-partitions": ["aws"],
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/aws-iam:standardizedServicePrincipals": true,
    "@aws-cdk/core:enablePartitionLiterals": true
  }
}
