# Copy to .env for local development: cp .env.example .env

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=ea
POSTGRES_PASSWORD=ea_local_pw
POSTGRES_DB=event_analytics
# Prisma connects to one database; the control and analytics schemas live inside it.
DATABASE_URL=postgresql://ea:ea_local_pw@localhost:15432/event_analytics?schema=control

# --- NATS (docker-compose, JetStream enabled) ---
NATS_URL=nats://localhost:4222

# --- API ---
API_PORT=8080
# Session cookie name. The design uses __Host-ea_sid which requires HTTPS+Secure.
# For local http development we use a plain name so the cookie works over http.
SESSION_COOKIE_NAME=ea_sid
SESSION_IDLE_MINUTES=30
# Comma-separated web origins allowed to call the API with credentials.
WEB_ORIGIN=http://localhost:5173

# --- Web (Vite) ---
# Base URL the web app uses to reach the API.
VITE_API_BASE=http://localhost:8080
