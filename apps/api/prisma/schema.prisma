// Event Analytics Platform - POC Prisma schema.
// Single Postgres database with two logical schemas (control + analytics),
// matching the design's pg-control / pg-analytics split without running two
// separate database servers. GDPR/audit/RLS/partitioning are deferred for the POC.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["control", "analytics"]
}

enum Role {
  user
  admin

  @@schema("control")
}

enum AccountStatus {
  active
  disabled

  @@schema("control")
}

enum CredentialStatus {
  active
  revoked

  @@schema("control")
}

// ---------------------------------------------------------------- control

model Account {
  id           String        @id @default(uuid())
  username     String        @unique
  role         Role          @default(user)
  status       AccountStatus @default(active)
  passwordHash String        @map("password_hash")
  createdAt    DateTime      @default(now()) @map("created_at")

  sessions     Session[]
  entitlements Entitlement[]

  @@map("account")
  @@schema("control")
}

model Session {
  idHash        String   @id @map("id_hash")
  accountId     String   @map("account_id")
  csrfToken     String   @map("csrf_token")
  idleExpiresAt DateTime @map("idle_expires_at")
  createdAt     DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("session")
  @@schema("control")
}

model Tenant {
  id               String   @id
  departmentOwner  String   @map("department_owner")
  privacyNoticeUrl String   @map("privacy_notice_url")
  retentionDays    Int      @default(396) @map("retention_days")
  createdAt        DateTime @default(now()) @map("created_at")

  entitlements Entitlement[]
  credentials  ProducerCredential[]
  allowedKeys  AllowedPropertyKey[]

  @@map("tenant")
  @@schema("control")
}

model Entitlement {
  accountId String   @map("account_id")
  tenantId  String   @map("tenant_id")
  grantedAt DateTime @default(now()) @map("granted_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([accountId, tenantId])
  @@index([tenantId])
  @@map("entitlement")
  @@schema("control")
}

model ProducerCredential {
  id         String           @id @default(uuid())
  tenantId   String           @map("tenant_id")
  secretHash String           @map("secret_hash")
  status     CredentialStatus @default(active)
  createdAt  DateTime         @default(now()) @map("created_at")
  revokedAt  DateTime?        @map("revoked_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("producer_credential")
  @@schema("control")
}

model AllowedPropertyKey {
  tenantId String   @map("tenant_id")
  key      String
  addedAt  DateTime @default(now()) @map("added_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, key])
  @@map("allowed_property_key")
  @@schema("control")
}

// -------------------------------------------------------------- analytics

// Stored event. Raw PII is never persisted: only a pseudonymous subject id and
// coarse derived values (country, browser/OS family). No payload column.
model Event {
  tenantId        String   @map("tenant_id")
  eventId         String   @map("event_id")
  ingestDate      DateTime @map("ingest_date") @db.Date
  ingestTs        DateTime @map("ingest_ts")
  eventTs         DateTime @map("event_ts")
  eventDate       DateTime @map("event_date") @db.Date
  eventType       String   @map("event_type")
  subjectId       String?  @map("subject_id") // pseudonymous HMAC; null = anonymous
  country         String?
  browserFamily   String?  @map("browser_family")
  osFamily        String?  @map("os_family")
  properties      Json
  contractVersion String   @map("contract_version")
  credentialId    String   @map("credential_id")

  @@id([tenantId, eventId])
  @@index([tenantId, subjectId])
  @@index([tenantId, ingestTs])
  @@map("event")
  @@schema("analytics")
}

model DedupKey {
  tenantId    String   @map("tenant_id")
  eventId     String   @map("event_id")
  firstSeenAt DateTime @default(now()) @map("first_seen_at")

  @@id([tenantId, eventId])
  @@index([firstSeenAt])
  @@map("dedup_key")
  @@schema("analytics")
}

// Exact daily rollup backing the dashboard. subjectKey is '' for anonymous.
model AggDaily {
  tenantId      String @map("tenant_id")
  eventDate     DateTime @map("event_date") @db.Date
  eventType     String @map("event_type")
  country       String
  browserFamily String @map("browser_family")
  osFamily      String @map("os_family")
  subjectKey    String @map("subject_key") // pseudonymous id or '' for anonymous
  eventCount    Int    @default(0) @map("event_count")

  @@id([tenantId, eventDate, eventType, country, browserFamily, osFamily, subjectKey])
  @@index([tenantId, eventDate])
  @@map("agg_daily")
  @@schema("analytics")
}

model DeadLetter {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  credentialId   String   @map("credential_id")
  reasonCode     String   @map("reason_code")
  fieldPath      String?  @map("field_path")
  deadLetteredAt DateTime @default(now()) @map("dead_lettered_at")
  expiresAt      DateTime @map("expires_at")

  @@index([tenantId, deadLetteredAt])
  @@index([expiresAt])
  @@map("dead_letter")
  @@schema("analytics")
}

// Per-minute ingest counters feeding the health snapshot.
model IngestStatsMinute {
  tenantId     String   @map("tenant_id")
  minute       DateTime
  accepted     Int      @default(0)
  duplicates   Int      @default(0)
  deadLettered Int      @default(0) @map("dead_lettered")
  droppedKeys  Int      @default(0) @map("dropped_keys")

  @@id([tenantId, minute])
  @@map("ingest_stats_minute")
  @@schema("analytics")
}
