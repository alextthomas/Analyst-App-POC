{
  "permissions": {
    "allow": [
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run format:*)",
      "Bash(npm run test:*)",
      "Bash(npx jest:*)",
      "Bash(npx vitest:*)",
      "Bash(npx playwright test:*)",
      "Bash(npx prisma generate)",
      "Bash(npx @stoplight/spectral-cli lint:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Edit(./.sdlc/exceptions/**)",
      "Write(./.sdlc/exceptions/**)",
      "Edit(./.github/CODEOWNERS)",
      "Write(./.github/CODEOWNERS)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push origin main:*)",
      "Bash(npx prisma migrate reset:*)",
      "Bash(npm publish:*)",
      "Bash(curl:*)",
      "Bash(gh auth:*)",
"Bash(gh pr review:*)",
"Bash(git config --global:*)"

    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node -e 'let s=\"\";process.stdin.on(\"data\",d=>s+=d).on(\"end\",()=>console.log(JSON.parse(s).tool_input.file_path))' | xargs -d '\\n' npx prettier --write --ignore-unknown || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/require-checks.sh"
          }
        ]
      }
    ]
  }
}
